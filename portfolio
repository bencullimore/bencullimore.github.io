  <title>My Service & Interaction Design Portfolio</title>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Overpass&family=Overpass+Mono&family=Archivo+Black&display=swap" rel="stylesheet">
  <style>
    /* Base styling and fonts */
    :root {
      --primary-blue: #0000ff;
      --font-primary: 'Overpass', sans-serif;
      --font-secondary: 'Archivo Black', sans-serif;
      --font-mono: 'Overpass Mono', monospace;
    }
    
    body {
      margin: 0;
      font-family: var(--font-primary);
      line-height: 1.6;
      color: #333;
      background: #f9f9f9;
    }
    
    header {
      background: var(--primary-blue);
      color: #fff;
      padding: 1rem 2rem;
    }
    
    header h1 {
      font-family: var(--font-secondary);
      margin: 0;
    }
    
    nav {
      margin-top: 1rem;
    }
    
    nav a {
      color: #fff;
      margin-right: 1rem;
      text-decoration: none;
      font-weight: bold;
    }
    
    section {
      padding: 2rem;
      max-width: 960px;
      margin: auto;
      background: #fff;
      margin-bottom: 1rem;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    
    h2 {
      color: var(--primary-blue);
      border-bottom: 2px solid var(--primary-blue);
      padding-bottom: 0.5rem;
    }
    
    /* Case Study Cards */
    .case-studies {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    
    .case-study {
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 1rem;
      flex: 1 1 calc(50% - 1rem);
      background: #fafafa;
    }
    
    .case-study h3 {
      margin-top: 0;
      color: var(--primary-blue);
    }
    
    /* Blog posts */
    .blog-post {
      border-bottom: 1px solid #ddd;
      padding: 1rem 0;
    }
    
    .blog-post:last-child {
      border-bottom: none;
    }
    
    footer {
      text-align: center;
      padding: 1rem;
      background: #eee;
      font-size: 0.9rem;
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
      .case-study {
        flex: 1 1 100%;
      }
    }
  </style>
</head>
